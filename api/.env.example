# ===== Database (MongoDB Atlas) =====
MONGO_URL=

# ===== Login =====
# String acak panjang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_DAYS=7

PORT=4100
# Alamat web yang boleh memanggil API (pisahkan koma)
CLIENT_ORIGIN=http://localhost:5173
CROSS_SITE_COOKIE=false

# ===== Admin pertama (dibuat otomatis kalau belum ada admin) =====
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== ml-service (Python) =====
ML_SERVICE_URL=http://127.0.0.1:5000
# Token rahasia bersama dengan ml-service (isi sama di kedua sisi saat deploy)
ML_SERVICE_TOKEN=

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Batas permintaan AI (pencarian + asisten) per user per hari. Admin bebas. 0 = tanpa batas.
AI_DAILY_LIMIT=30

# ===== Email lupa password (Gmail + App Password, boleh sama dengan HNI-Project) =====
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chemistry <emailkamu@gmail.com>
# Email kontak di halaman Privasi. Kosong = SMTP_USER.
CONTACT_EMAIL=
# Alamat web untuk link di email. Kosong = alamat pertama CLIENT_ORIGIN.
APP_URL=
